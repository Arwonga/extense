          Enquire
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- ===================== -->
    <!-- 5. DELIVERABLES / ROI -->
    <!-- ===================== -->
    <mj-section background-color="#ffffff" padding="70px 20px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" font-family="'Playfair Display', Georgia, serif" font-size="28px" color="#111111" padding-bottom="50px">
          Our deliverables benefit your business outcomes.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0px 10px 70px 10px">
      
      <!-- ITEM 1 -->
      <mj-column width="25%" padding="0px 10px">
        <!-- Replace src with your hosted 36% circle image -->
        <mj-image src="https://github.com/Arwonga/extense/blob/main/Extense/36%25+BETTER+PROFIT+PROSPECTS.png?raw=true" alt="36% Better Profit Prospects" width="130px" padding-bottom="20px" />
        <mj-text align="center" border="1px solid #A88755" padding="15px 5px" font-size="12px" line-height="18px">
          Enhance your profitability &nbsp;<span style="font-size: 10px;">+</span>
        </mj-text>
      </mj-column>
      
      <!-- ITEM 2 -->
      <mj-column width="25%" padding="0px 10px">
         <!-- Replace src with your hosted 20% circle image -->
         <mj-image src="https://github.com/Arwonga/extense/blob/main/Extense/20%25+LESS+TENURE.png?raw=true" alt="20% Less Tenure" width="130px" padding-bottom="20px" />
         <mj-text align="center" border="1px solid #A88755" padding="15px 5px" font-size="12px" line-height="18px">
          Tackle your<br/>'stay gap' &nbsp;<span style="font-size: 10px;">+</span>
        </mj-text>
      </mj-column>
      
      <!-- ITEM 3 -->
      <mj-column width="25%" padding="0px 10px">
