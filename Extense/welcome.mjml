        <mj-text align="center" font-weight="600" color="#111111">External 'stay interviews'</mj-text>
      </mj-column>
      <mj-column width="50%" padding-bottom="40px">
        <mj-image src="https://github.com/Arwonga/extense/blob/main/Extense/retained.png?raw=true" alt="Retained search" width="90px" padding-bottom="15px" />
        <mj-text align="center" font-weight="600" color="#111111">Retained search</mj-text>
      </mj-column>

      <!-- Row 4 -->
      <mj-column width="50%" padding-bottom="40px">
        <mj-image src="https://github.com/Arwonga/extense/blob/main/Extense/inclussive.png?raw=true" alt="Inclusive recruiting workshop" width="90px" padding-bottom="15px" />
        <mj-text align="center" font-weight="600" color="#111111">Inclusive recruiting workshop</mj-text>
      </mj-column>
      <mj-column width="50%" padding-bottom="40px">
        <mj-image src="https://github.com/Arwonga/extense/blob/main/Extense/Speaker.png?raw=true" alt="Speaker / Moderator booking" width="90px" padding-bottom="15px" />
        <mj-text align="center" font-weight="600" color="#111111">Speaker / Moderator booking</mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Enquire Button for Grid -->
    <mj-section background-color="#ffffff" padding="0px 20px 60px 20px">
      <mj-column width="100%">
