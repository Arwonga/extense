         <mj-text align="center" border="1px solid #A88755" padding="15px 5px" font-size="12px" line-height="18px">
          Level your<br/>playing field &nbsp;<span style="font-size: 10px;">+</span>
        </mj-text>
      </mj-column>
      
      <!-- ITEM 4 -->
      <mj-column width="25%" padding="0px 10px">
         <!-- Replace src with your hosted 10% circle image -->
         <mj-image src="https://github.com/Arwonga/extense/blob/main/Extense/10%25+HIGHER+EBIT.png?raw=true" alt="10% Higher EBIT" width="130px" padding-bottom="20px" />
         <mj-text align="center" border="1px solid #A88755" padding="15px 5px" font-size="12px" line-height="18px">
          Increase your<br/>earnings &nbsp;<span style="font-size: 10px;">+</span>
        </mj-text>
      </mj-column>
      
    </mj-section>

    <!-- ===================== -->
    <!-- 6. THE 1% STUDY       -->
    <!-- ===================== -->
    <mj-section background-color="#ffffff" padding="70px 30px">
      <mj-column width="100%">
        <mj-text align="center" font-family="'Playfair Display', Georgia, serif" font-size="32px" color="#A88755" padding-bottom="10px">
          The 1% Study
        </mj-text>
        <mj-divider border-width="1px" border-color="#A88755" width="60px" padding-bottom="30px" />
        
        <mj-text align="left" color="#444444" padding-bottom="20px">
          The 1% Study' is an <strong>extense</strong> primary research investigation to discover the key contributing factors that have assisted Black solicitors to reach the partnership level within major law firms in the UK. The research is endorsed by the <strong>Black Solicitors Network, The Law Society of England and Wales</strong>, and the <strong>Solicitors Regulation Authority</strong>.
        </mj-text>
        
        <mj-text align="left" color="#444444" padding-bottom="20px">
          <strong>Rt Hon. David Lammy MP</strong> (UK Deputy Prime Minister) is the official Patron to 'The 1% Study'.
        </mj-text>
        
        <mj-text align="left" color="#444444" padding-bottom="40px">
          'The 1% Study' is sponsored by: <strong>DLA Piper; Herbert Smith Freehills; Hogan Lovells; Latham & Watkins;</strong> and <strong>Linklaters</strong>.
        </mj-text>

      </mj-column>
    </mj-section>


    <mj-section background-color="#ffffff" padding="0px 20px 70px 20px">
      <mj-column width="100%">
    
        <mj-image src="https://github.com/Arwonga/extense/blob/main/Extense/1%25.webp?raw=true" alt="Launch Event Video" href="https://extense.co.uk/the-1-study" border="1px solid #e0e0e0" />
      </mj-column>
    </mj-section>

    <!-- ===================== -->
    <!-- 8. CONTACT US         -->
    <!-- ===================== -->
    <mj-section background-color="#fbfaf8" padding="70px 20px">
      <mj-column width="100%">
        <mj-text align="center" font-family="'Playfair Display', Georgia, serif" font-size="32px" color="#111111" padding-bottom="15px">
          Contact
        </mj-text>
        <mj-divider border-width="1px" border-color="#A88755" width="40px" padding-bottom="25px" />
